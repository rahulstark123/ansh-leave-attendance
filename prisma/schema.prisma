datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

model Employee {
  id             String         @id // Matches Supabase Auth ID
  name           String
  email          String         @unique
  role           String         // "Admin" | "HR Manager" | "Employee"
  department     String
  avatarInitials String
  status         String         // "Active" | "On Leave" | "Half-day" | "Off"
  annualBalance  Float          @default(15)
  sickBalance    Float          @default(8)
  casualBalance  Float          @default(6)
  currentPunchIn String?        // Active punch-in timestamp
  currentPunchInPhoto String?   // S3 URL of the punch-in selfie photo
  currentPunchInLat   Float?    // Check-in location latitude
  currentPunchInLng   Float?    // Check-in location longitude
  companyName    String?        // Company Name for Admins/HR Managers
  companyAddress String?        // Company Address for Admins/HR Managers
  employeeCount  String?        // Employee Count range for Admins/HR Managers
  wid            Int?           // Workspace ID
  employeeCode          String?        // Unique Employee Code e.g. ANSH-001
  phoneNumber           String?        // Phone Number
  joiningDate           String?        // Date of Joining
  designation           String?        // Job Title e.g. Senior Software Engineer
  employmentType        String?        // e.g. Full-time, Part-time, Contract, Intern
  reportingManager      String?        // Name of Reporting Manager
  reportingHR           String?        // Name of Reporting HR
  workLocation          String?        // e.g. Remote, On-site, Hybrid
  branch                String?        // Assigned branch/office name (e.g. Main HQ, Bengaluru Tech Hub)
  rosterShift           String?        // Assigned shift roster name
  personalEmail         String?        // Personal Email Address
  dateOfBirth           String?        // Date of Birth (YYYY-MM-DD)
  emergencyContactName  String?        // Emergency Contact Name
  emergencyContactPhone String?        // Emergency Contact Phone Number
  bloodGroup            String?        // e.g. A+, B-, O+
  faceEmbedding         Float[]
  facePhotos            String[]
  createdAt             DateTime       @default(now())
  leaves                LeaveRequest[]
  punches               PunchRecord[]
  regularizations       AttendanceRegularization[]
  wfhRequests           WFHRequest[]
  createdChannels       WorkspaceChannel[]         @relation("ChannelCreator")
  channelMemberships    ChannelMember[]
  sentMessages          WorkspaceMessage[]         @relation("MessageSender")
  receivedMessages      WorkspaceMessage[]         @relation("MessageReceiver")
  supportTickets        SupportTicket[]
}

model LeaveRequest {
  id             String   @id @default(cuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type           String   // "Annual" | "Sick" | "Casual" | "Unpaid" | "Maternity/Paternity"
  startDate      String   // Date string "YYYY-MM-DD"
  endDate        String   // Date string "YYYY-MM-DD"
  totalDays      Float
  halfDay        Boolean
  reason         String
  status         String   // "Pending" | "Approved" | "Rejected"
  wid            Int?     // Workspace ID
  appliedAt      DateTime @default(now())
}

model PunchRecord {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       String    // Date string "YYYY-MM-DD"
  punchIn    String    // Time string e.g. "09:05 AM"
  punchOut   String?   // Time string e.g. "06:12 PM"
  duration   String?   // e.g. "9h 07m"
  status     String    // "On-time" | "Late" | "Half-day" | "Absent" | "WFH" | "Regularized"
  wid        Int?      // Workspace ID
  punchInPhoto  String?   // S3 URL of the punch-in selfie photo
  punchOutPhoto String?   // S3 URL of the punch-out selfie photo
  punchInLat    Float?    // Check-in location latitude
  punchInLng    Float?    // Check-in location longitude
  punchOutLat   Float?    // Check-out location latitude
  punchOutLng   Float?    // Check-out location longitude
}

model Workspace {
  id            Int            @id @default(autoincrement())
  name          String?
  plan          String         @default("free") // "free" | "pro"
  planExpiresAt DateTime?
  trialEndsAt   DateTime?      // 14-day Pro trial for new workspaces
  maxUsers      Int            @default(5)
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]
  transactions  Transaction[]
}

model Subscription {
  id              String        @id @default(cuid())
  workspaceId     Int
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employeeId      String?
  status          String        // "PENDING" | "ACTIVE" | "CANCELLED"
  plan            String        // "pro"
  seatsCount      Int           @default(1)
  billingCycle    String        // "monthly" | "yearly"
  amountPaisa     Int
  currency        String        @default("INR")
  razorpayOrderId String?
  startsAt        DateTime?
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())
  transactions    Transaction[]

  @@index([workspaceId])
  @@index([razorpayOrderId])
}

model Transaction {
  id                String        @id @default(cuid())
  workspaceId       Int
  workspace         Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscriptionId    String?
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  status            String        // "CREATED" | "SUCCESS" | "FAILED"
  amountPaisa       Int
  currency          String        @default("INR")
  razorpayOrderId   String        @unique
  razorpayPaymentId String?
  razorpaySignature String?
  description       String?
  createdAt         DateTime      @default(now())

  @@index([workspaceId])
  @@index([subscriptionId])
}

model LeaveCategory {
  id               String   @id @default(cuid())
  name             String
  days             Int
  color            String
  allowRollover    Boolean  @default(false)
  description      String?
  applicableGender String   @default("All") // "All" | "Male" | "Female"
  accrualPolicy    String   @default("One-time") // "One-time" | "Monthly" | "Yearly"
  requiresProof    Boolean  @default(false)
  branchId         String   @default("All") // "All" or specific branch name/ID
  wid              Int      @default(1) // Workspace ID for multi-tenant isolation
  createdAt        DateTime @default(now())
}

model CompanyHoliday {
  id        String   @id @default(cuid())
  name      String
  date      String   // Date string "YYYY-MM-DD"
  type      String   // "Gazetted" | "Restricted"
  branchId  String   @default("All") // "All" or specific branch name
  wid       Int      @default(1)     // Workspace ID for multi-tenant isolation
  createdAt DateTime @default(now())
}

model Shift {
  id           String   @id @default(cuid())
  name         String
  startTime    String   // e.g., "09:00 AM"
  endTime      String   // e.g., "06:00 PM"
  gracePeriod  Int      @default(15) // in minutes
  workingHours Float    @default(9)  // required hours
  branchId     String   @default("All") // "All" or specific branch name/ID
  wid          Int      @default(1)  // Workspace ID for multi-tenant isolation
  createdAt    DateTime @default(now())
}

model Designation {
  id        String   @id @default(cuid())
  name      String
  wid       Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([name, wid])
  @@index([wid])
}

model AttendanceRegularization {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date         String   // YYYY-MM-DD
  requestedIn  String   // e.g., "09:00 AM"
  requestedOut String   // e.g., "06:00 PM"
  reason       String
  status       String   // "Pending" | "Approved" | "Rejected"
  wid          Int      @default(1)
  appliedAt    DateTime @default(now())
}

model WFHRequest {
  id             String   @id @default(cuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startDate      String   // YYYY-MM-DD
  endDate        String   // YYYY-MM-DD
  totalDays      Float
  halfDay        Boolean  @default(false)
  reason         String
  status         String   // "Pending" | "Approved" | "Rejected"
  wid            Int      @default(1)
  appliedAt      DateTime @default(now())
}

model WorkspaceChannel {
  id          String             @id @default(cuid())
  name        String
  description String             @default("")
  isPublic    Boolean            @default(true)
  createdById String
  createdBy   Employee           @relation("ChannelCreator", fields: [createdById], references: [id], onDelete: Cascade)
  wid         Int                @default(1)
  createdAt   DateTime           @default(now())
  members     ChannelMember[]
  messages    WorkspaceMessage[]

  @@unique([name, wid])
  @@index([wid])
}

model ChannelMember {
  id         String           @id @default(cuid())
  channelId  String
  channel    WorkspaceChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  joinedAt   DateTime         @default(now())

  @@unique([channelId, employeeId])
}

model WorkspaceMessage {
  id         String            @id @default(cuid())
  content    String
  senderId   String
  sender     Employee          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  channelId  String?
  channel    WorkspaceChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  receiverId String?
  receiver   Employee?         @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  wid        Int               @default(1)
  sentAt     DateTime          @default(now())

  @@index([channelId, sentAt])
  @@index([senderId, receiverId, sentAt])
  @@index([wid])
}

model SupportTicket {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category    String   // "Leave Issue" | "Attendance Correction" | "IT Support" | "Profile Update" | "Other"
  subject     String
  description String
  status      String   // "Open" | "In_Progress" | "Resolved"
  priority    String   // "Low" | "Medium" | "High"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  wid         Int      @default(1)
}

